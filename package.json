{
  "name": "pxhvibe",
  "version": "0.1.0",
  "description": "PXHVibe terminal coding agent with free and custom API modes.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tui",
    "coding-agent",
    "ai",
    "cli"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pxh": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import {rm} from 'node:fs/promises'; await rm('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "npm run build && npm run test:free && npm run test:agent && npm run test:modes && npm run test:custom && npm run test:commands",
    "test:agent": "node dist/tests/nativeAgent.test.js",
    "test:free": "node dist/tests/openCodeProvider.test.js",
    "test:modes": "node dist/tests/modes.test.js",
    "test:custom": "node dist/tests/customApiSetup.test.js",
    "test:commands": "node dist/tests/slashCommands.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "opencode-ai": "^1.18.18",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
