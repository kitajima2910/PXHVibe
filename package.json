{
  "name": "pxhvibe",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal terminal vibe coding interface built with React and Ink.",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "dev": "npm run build && node dist/cli.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
