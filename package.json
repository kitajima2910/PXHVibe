{
  "name": "pxhvibe",
  "version": "0.14.0",
  "description": "PXHVibe terminal coding agent with free and custom API modes.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "tui",
    "coding-agent",
    "ai",
    "cli"
  ],
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "pxh": "dist/cli.js"
  },
  "scripts": {
    "dev": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "clean": "node --input-type=module -e \"import {rm} from 'node:fs/promises'; await rm('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "npm run build && npm run test:free && npm run test:agent && npm run test:router && npm run test:orchestration && npm run test:pipeline && npm run test:team && npm run test:runtime-commands && npm run test:format && npm run test:title && npm run test:modes && npm run test:custom && npm run test:commands && npm run test:branding && npm run test:image && npm run test:viewport && npm run test:todo && npm run test:picker",
    "test:agent": "node dist/tests/nativeAgent.test.js",
    "test:router": "node dist/tests/agents.test.js",
    "test:orchestration": "node dist/tests/orchestration.test.js",
    "test:pipeline": "node dist/tests/pipeline.test.js",
    "test:team": "node dist/tests/teamRunner.test.js",
    "test:runtime-commands": "node dist/tests/runtimeCommands.test.js",
    "test:format": "node dist/tests/terminalFormat.test.js",
    "test:title": "node dist/tests/terminalTitle.test.js",
    "test:free": "node dist/tests/openCodeProvider.test.js",
    "test:modes": "node dist/tests/modes.test.js",
    "test:custom": "node dist/tests/customApiSetup.test.js",
    "test:commands": "node dist/tests/slashCommands.test.js",
    "test:branding": "node dist/tests/outputBranding.test.js",
    "test:image": "node dist/tests/imageClipboard.test.js",
    "test:viewport": "node dist/tests/messageViewport.test.js",
    "test:todo": "node dist/tests/todoStrip.test.js",
    "test:picker": "node dist/tests/agentPicker.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "openai": "^7.4.0",
    "opencode-ai": "^1.18.18",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
